<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later draw the opening screen themselves: the navy, the
         mascot in the middle and MANTA SHARK at the bottom (owner, 2026-10-27). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_brand</item>
    </style>
</resources>
